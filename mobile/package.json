{
  "name": "quotehawk-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo/AppEntry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "export:web": "EXPO_OFFLINE=1 expo export --platform web --output-dir dist",
    "export:android": "EXPO_OFFLINE=1 expo export --platform android --output-dir dist"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "expo": "~58.0.25",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "minimatch": "11.0.8"
  }
}
