# Server-only origin used by `next dev` rewrites. Browser code always uses /api/rfq.
QUOTEHAWK_API_ORIGIN=http://127.0.0.1:8000

# `npm run build:static` sets this automatically. The exported UI expects a reverse
# proxy that maps /api/rfq to the QuoteHawk FastAPI service.
QUOTEHAWK_STATIC_EXPORT=false
