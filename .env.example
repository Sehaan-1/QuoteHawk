# QuoteHawk local configuration
# All deterministic policy tests run without these credentials.

# Optional Gemini/ADK drafting and extraction (PR 3). Set one key locally; never commit it.
# GOOGLE_API_KEY=your-google-ai-studio-key
# GEMINI_API_KEY=your-google-ai-studio-key
MODEL_NAME=gemini-3.8-flash

# SQLite supplier memory. Use an absolute path when running under a container.
QUOTEHAWK_DATABASE_PATH=quotehawk.db
