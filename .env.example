# QuoteHawk local configuration
# All deterministic policy tests run without these credentials.

# Optional Gemini/ADK drafting and extraction. Set one key locally; never commit it.
# GOOGLE_API_KEY=your-google-ai-studio-key
# GEMINI_API_KEY=your-google-ai-studio-key
MODEL_NAME=gemini-3.8-flash

# SQLite supplier memory is the default. Use the Docker default /data/quotehawk.db
# with a mounted volume; SQLite is single-instance local-prototype storage, not
# production HA DB.
QUOTEHAWK_PERSISTENCE_BACKEND=sqlite
QUOTEHAWK_DATABASE_PATH=quotehawk.db

# To opt into the Postgres repository, apply the reviewed schema first, then set
# QUOTEHAWK_PERSISTENCE_BACKEND=postgres and provide a secret-managed DSN. QuoteHawk
# never falls back to SQLite if this DSN is missing and never auto-migrates on API start.
# QUOTEHAWK_POSTGRES_DSN=postgresql://quotehawk_app:password@db.example.com:5432/quotehawk?sslmode=require
# uv run python -m app.persistence.postgres --dsn "$QUOTEHAWK_POSTGRES_DSN"

# Authentication defaults to a credential-free local prototype mode. It is not
# production authentication; it only keeps the existing fixture/demo clients usable.
QUOTEHAWK_AUTH_MODE=prototype
QUOTEHAWK_AUTHORIZED_BUYERS=demo-buyer
QUOTEHAWK_PROTOTYPE_TENANT_ID=local-demo

# To enforce verified OIDC bearer JWTs, set QUOTEHAWK_AUTH_MODE=oidc and configure
# every value below. QuoteHawk verifies an existing identity-provider token; it does
# not host an OAuth login, provision an IdP, or accept a client-supplied buyer ID.
# QUOTEHAWK_OIDC_ISSUER=https://identity.example.com/
# QUOTEHAWK_OIDC_AUDIENCE=quotehawk-api
# QUOTEHAWK_OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
# QUOTEHAWK_OIDC_TENANT_CLAIM=tenant_id
# QUOTEHAWK_OIDC_ROLES_CLAIM=roles
# QUOTEHAWK_OIDC_READ_ROLE=quotehawk.rfq.read
# QUOTEHAWK_OIDC_WRITE_ROLE=quotehawk.rfq.write
# QUOTEHAWK_OIDC_APPROVE_ROLE=quotehawk.rfq.approve
# QUOTEHAWK_OIDC_ALGORITHMS=RS256

# Keep credential-free local API startup working. Enable only in a configured GCP deployment.
QUOTEHAWK_OTEL_TO_CLOUD=false

# Optional CORS origin list for a directly served local API. Prefer the documented
# same-origin reverse proxy for browser deployments; do not use a wildcard in production.
# ALLOW_ORIGINS=https://buyer.example.com

# Docker listens on this port and exposes a side-effect-free /api/rfq/healthz endpoint.
PORT=8080

# Local structured logs are emitted to stderr and include only request/run IDs,
# route templates, status, duration, state/count metrics, and draft-only outcomes.
# They never include request bodies, supplier documents, commercial values, model traces, or secrets.
